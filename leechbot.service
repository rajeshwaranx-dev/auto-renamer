[Unit]
Description=Auto Renamer Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/auto-renamer
ExecStart=/root/auto-renamer/venv/bin/python3 /root/auto-renamer/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
